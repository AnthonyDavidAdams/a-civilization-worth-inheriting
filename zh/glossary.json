 "parts": {
  "1": {
   "name": "跨越时间的责任",
   "epigraph": "确立一个文明对当下的生命、以及对将继承其决定的后人所负有的责任。",
   "label": "第一部分"
  },
  "2": {
   "name": "共同成为人",
   "epigraph": "创造让人们得以成长、归属并彼此照护的条件。",
   "label": "第二部分"
  },
  "3": {
   "name": "活着的星球",
   "epigraph": "将生态完整性与动物个体的生命视为既有区别又相互关联的责任。",
   "label": "第三部分"
  },
  "4": {
   "name": "场所与物质生活",
   "epigraph": "建造令人乐于居住、也能够持续维系的聚落。",
   "label": "第四部分"
  },
  "5": {
   "name": "支持生命的经济",
   "epigraph": "让有用的生产与共享的繁荣及生态限度相容。",
   "label": "第五部分"
  },
  "6": {
   "name": "保持可问责的权力",
   "epigraph": "让集体行动成为可能，同时防止临时的权威变成永久的支配。",
   "label": "第六部分"
  },
  "7": {
   "name": "能够认知的文明",
   "epigraph": "让知识保持有用、可质疑、可获取，并能在创造者之后继续存续。",
   "label": "第七部分"
  },
  "8": {
   "name": "与人工心智共处",
   "epigraph": "把能力、权威、所有权与道德地位的问题分开来看。",
   "label": "第八部分"
  },
  "9": {
   "name": "穿越动荡的延续",
   "epigraph": "降低灾难发生的可能，让复原成为可能，同时不让永久紧急状态成为常态。",
   "label": "第九部分"
  },
  "10": {
   "name": "宇宙中的邻居",
   "epigraph": "把责任延伸到地球之外，同时认真对待不确定性与距离。",
   "label": "第十部分"
  },
  "11": {
   "name": "值得过的生活",
   "epigraph": "为欢乐、美、文化、精神探寻，以及无需经济理由的体验留出空间。",
   "label": "第十一部分"
  },
  "12": {
   "name": "让语言发挥作用",
   "epigraph": "把宏大的承诺化为本地行动，并让经验改进这本书。",
   "label": "第十二部分"
  }
 },
